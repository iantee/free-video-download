# 复制为 .env 后按需填写。不配 Key 时解析/下载仍可用，AI 会明确提示未配置。

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 其它站点若必须登录态：填写 chrome / edge / firefox
# 抖音公开视频默认不需要这项。B 站 CC 字幕需要登录态；读不到 Cookie 时会改走 Whisper
COOKIES_FROM_BROWSER=
# 也可以改用 Netscape 格式的 Cookie 文件路径（优先于上面的浏览器）
COOKIES_FILE=

# 无平台字幕时的本地转写。默认 base，CPU int8。留空则自动识别语言
WHISPER_MODEL=base
WHISPER_LANGUAGE=
# 连不上 huggingface.co 时改用镜像，例如 https://hf-mirror.com
HF_ENDPOINT=
